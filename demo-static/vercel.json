{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/grocery-dashboard.html" },
    { "source": "/dashboard", "destination": "/grocery-dashboard.html" },
    { "source": "/terminal", "destination": "/grocery-terminal.html" },
    { "source": "/products", "destination": "/grocery-products.html" },
    { "source": "/batches", "destination": "/grocery-batches.html" },
    { "source": "/expiry", "destination": "/grocery-expiry.html" },
    { "source": "/receiving", "destination": "/grocery-receiving.html" },
    { "source": "/waste", "destination": "/grocery-waste.html" },
    { "source": "/recalls", "destination": "/grocery-recalls.html" },
    { "source": "/reports", "destination": "/grocery-reports.html" }
  ],
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }]
}

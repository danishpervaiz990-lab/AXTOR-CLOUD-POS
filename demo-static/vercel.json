{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": false },
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/hardware-dashboard.html" },
    { "source": "/dashboard", "destination": "/hardware-dashboard.html" },
    { "source": "/terminal", "destination": "/hardware-terminal.html" },
    { "source": "/projects", "destination": "/hardware-projects.html" },
    { "source": "/quotations", "destination": "/hardware-quotations.html" },
    { "source": "/deliveries", "destination": "/hardware-deliveries.html" },
    { "source": "/reports", "destination": "/hardware-reports.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}

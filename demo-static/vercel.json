{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "frontend-*": false,
      "fix/*": false,
      "ops/*": false,
      "backend": false
    }
  },
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "/login.html", "permanent": false },
    { "source": "/index.html", "destination": "/login.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/apps/:industry", "destination": "/api/industry-asset?industry=:industry" },
    { "source": "/apps/:industry/:path*", "destination": "/api/industry-asset?industry=:industry&path=:path*" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/onboarding", "destination": "/tenant-onboarding.html" },
    { "source": "/router", "destination": "/router.html" },
    { "source": "/dashboard.html", "destination": "/router.html" },
    { "source": "/industry.html", "destination": "/router.html" },
    { "source": "/session-handoff", "destination": "/session-handoff.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/login.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/login",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/industry-hosts.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }
      ]
    },
    {
      "source": "/apps/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "X-Axtor-Gateway-Release", "value": "20260804-strict-industry-development1" },
        { "key": "X-Axtor-Gateway-Patch", "value": "20260804-strict2-trial-label1" }
      ]
    }
  ]
}

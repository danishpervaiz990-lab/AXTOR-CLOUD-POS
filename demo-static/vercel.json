{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/school-dashboard.html" },
    { "source": "/dashboard", "destination": "/school-dashboard.html" },
    { "source": "/admissions", "destination": "/school-admissions.html" },
    { "source": "/students", "destination": "/school-students.html" },
    { "source": "/attendance", "destination": "/school-attendance.html" },
    { "source": "/fees", "destination": "/school-fees.html" },
    { "source": "/reports", "destination": "/school-reports.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}

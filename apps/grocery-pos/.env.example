# AXTOR Grocery POS Cloud
# Copy to .env.local for local development. Never commit real values.

# Existing AXTOR Node.js/Express backend. Do not create a second Railway service.
AXTOR_SHARED_BACKEND_URL="https://axtor-cloud-pos-production.up.railway.app"
NEXT_PUBLIC_AXTOR_SHARED_BACKEND_URL="https://axtor-cloud-pos-production.up.railway.app"

GROCERY_SESSION_SECRET="replace-with-at-least-32-random-characters"
GROCERY_APP_URL="http://localhost:3000"
GROCERY_ENVIRONMENT="development"
GROCERY_LOG_LEVEL="info"
GROCERY_CRON_SECRET="replace-with-a-separate-random-secret"
GROCERY_FILE_STORAGE_PROVIDER="vercel-blob"
GROCERY_EMAIL_FROM_NAME="AXTOR Grocery POS Cloud"
GROCERY_EMAIL_FROM_ADDRESS="no-reply@example.com"
VERCEL_GIT_COMMIT_SHA=""
VERCEL_DEPLOYMENT_ID=""

# Required: Railway PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Required: long random authentication secret.
AUTH_TOKEN_SECRET="replace-with-a-long-random-secret"

AUTH_TOKEN_EXPIRES_SECONDS="86400"
NODE_ENV="production"
PORT="3000"
CORS_ORIGIN="https://your-frontend.vercel.app"
APP_NAME="Axtor POS Cloud API"

PLATFORM_ADMIN_EMAILS="platform-owner@example.com"

APP_VERSION="2026.07-global-saas"
SUPPORT_EMAIL="support@example.com"
SUPPORT_URL="https://example.com/support"

# Optional commercial backup provider. All three core values are required
# before backup requests are accepted. Never commit real credentials.
# Railway Volume example: BACKUP_STORAGE_URL="/data/axtor-backups"
# S3 example: BACKUP_STORAGE_URL="s3://private-bucket/axtor"
BACKUP_PROVIDER="railway-volume"
BACKUP_STORAGE_URL="/data/axtor-backups"
BACKUP_ENCRYPTION_KEY="replace-with-at-least-32-random-characters"
BACKUP_WORKER_ENABLED="true"
BACKUP_WORKER_INTERVAL_SECONDS="30"
BACKUP_RETENTION_DAYS="30"
BACKUP_MAX_ATTEMPTS="3"

# Required only for s3-compatible/object-storage providers.
BACKUP_S3_REGION="auto"
BACKUP_S3_ENDPOINT=""
BACKUP_S3_FORCE_PATH_STYLE="true"
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""

# Optional isolated restore drill. The worker refuses to restore to DATABASE_URL.
# Set the confirmation value exactly as shown only for an isolated disposable DB.
BACKUP_RESTORE_DATABASE_URL=""
BACKUP_RESTORE_CONFIRM=""

SEED_BUSINESS_NAME="Axtor Demo Business"
SEED_BUSINESS_SLUG="axtor-demo"
SEED_OWNER_NAME="Owner"

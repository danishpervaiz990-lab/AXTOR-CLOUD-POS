  @@unique([businessId, salesmanId, month])
  @@index([businessId, month])
  @@map("salesman_targets")
}

model CommissionPayout {
  id               String    @id @default(cuid())
  businessId       String    @map("business_id")
  salesmanId       String    @map("salesman_id")
  month            String
  grossSales       Decimal   @default(0) @map("gross_sales") @db.Decimal(14, 2)
  achievementPct   Decimal   @default(0) @map("achievement_pct") @db.Decimal(8, 2)
  commissionRate   Decimal   @default(0) @map("commission_rate") @db.Decimal(5, 2)
  commissionAmount Decimal   @default(0) @map("commission_amount") @db.Decimal(14, 2)
  bonusAmount      Decimal   @default(0) @map("bonus_amount") @db.Decimal(14, 2)
  totalPayout      Decimal   @default(0) @map("total_payout") @db.Decimal(14, 2)
  status           String    @default("pending")
  approvedByUserId String?   @map("approved_by_user_id")
  paidDate         DateTime? @map("paid_date")
  paymentMethod    String?   @map("payment_method")
  notes            String?
  disputed         Boolean   @default(false)
  disputeReason    String?   @map("dispute_reason")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  salesman Salesman @relation(fields: [salesmanId], references: [id], onDelete: Cascade)

  @@unique([businessId, salesmanId, month])
  @@index([businessId, month])
  @@index([businessId, status])
  @@map("commission_payouts")
}

model StockCount {

model Counter {
  id            String        @id @default(cuid())
  businessId    String        @map("business_id")
  branchId      String?       @map("branch_id")
  name          String
  code          String?
  cashierUserId String?       @map("cashier_user_id")
  status        CounterStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  shifts   Shift[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([branchId])
  @@map("counters")
}

model Shift {
  id             String      @id @default(cuid())
  businessId     String      @map("business_id")
  branchId       String?     @map("branch_id")
  counterId      String?     @map("counter_id")
  cashierUserId  String?     @map("cashier_user_id")
  cashierName    String?     @map("cashier_name")
  counterName    String?     @map("counter_name")
  openedByUserId String?     @map("opened_by_user_id")
  closedByUserId String?     @map("closed_by_user_id")
  openingCash    Decimal     @default(0) @map("opening_cash") @db.Decimal(14, 2)
  closingCash    Decimal?    @map("closing_cash") @db.Decimal(14, 2)
  expectedCash   Decimal?    @map("expected_cash") @db.Decimal(14, 2)
  variance       Decimal?    @db.Decimal(14, 2)
  status         ShiftStatus @default(OPEN)
  openedAt       DateTime    @default(now()) @map("opened_at")
  closedAt       DateTime?   @map("closed_at")
  notes          String?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  counter  Counter? @relation(fields: [counterId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, status])
  @@index([counterId])
  @@map("shifts")
}


{
  "name": "axtor-pos-cloud-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed:owner": "tsx src/scripts/seed-owner.ts",
    "seed:catalog": "tsx src/scripts/seed-commercial-catalog.ts",
    "release:deploy": "node dist/server.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.22.2",
    "helmet": "8.1.0",
    "morgan": "1.11.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/morgan": "1.9.9",
    "@types/node": "22.15.3",
    "prisma": "6.19.3",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
